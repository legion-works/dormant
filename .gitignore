# opencode per-project runtime state (specs/plans stay local, not tracked)
.opencode/

# Rust (once scaffolded)
/target/

# The nextest-policy fixture is a real crate that verify_nextest_policy.py
# builds in place, so running that gate locally leaves a lockfile and a target
# directory behind. Neither is an input to the check.
/.github/fixtures/nextest-policy/Cargo.lock
/.github/fixtures/nextest-policy/target/
Cargo.lock.orig

# editor / OS noise
*.swp
.DS_Store

# parallel-agent worktrees
.worktrees/
# Generated mdbook output
/docs/book/

# Python bytecode caches (scripts/ci/*.py)
__pycache__/
*.pyc

# Operator scratch: dropped-in archives (third-party source, reference material).
# Never commit these — a public repo should not carry unlicensed vendor drops.
*.zip
